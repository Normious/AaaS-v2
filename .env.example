# Server
PORT=3000
ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=./data/aaas-v2.db
DB_POOL_SIZE=20

# JWT Signing (EdDSA Ed25519)
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=https://auth.yourdomain.com
JWT_AUDIENCE=api.yourdomain.com
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Argon2id (OWASP 2024)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Session
SESSION_MAX_DEVICES=10
SESSION_IDLE_TIMEOUT_DAYS=90

# Account Lockout
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_MINUTES=15

# Rate Limiting
RL_LOGIN_PER_IP_PER_MIN=20
RL_LOGIN_PER_EMAIL_PER_MIN=5
RL_REGISTER_PER_IP_PER_HOUR=10
RL_PASSWORD_RESET_PER_EMAIL_PER_HOUR=3

# Email (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=AaaS

# URLs (for email links)
APP_BASE_URL=https://yourdomain.com
EMAIL_VERIFY_PATH=/verify-email
PASSWORD_RESET_PATH=/reset-password

# CORS
CORS_ALLOWED_ORIGINS=*
